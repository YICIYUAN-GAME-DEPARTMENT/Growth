; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Growth"
config/description="2026 GameJam project — theme: Grow. Built with Godot 4.7 + GDScript."
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://Scripts/Autoload/GameManager.gd"
EventManager="*res://Scripts/Autoload/EventManager.gd"
ResourceManager="*res://Scripts/Autoload/ResourceManager.gd"
AudioManager="*res://Scripts/Autoload/AudioManager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

; Core movement / interaction (re-map in team settings as needed)
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194320)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194322)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194319)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194321)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":69)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305)]
}
ui_confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":90), Object(InputEventKey,"keycode":4194309)]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":88), Object(InputEventKey,"keycode":4194308)]
}

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="Projectile"
2d_physics/layer_5="Trigger"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/canvas_textures/default_texture_filter=0
