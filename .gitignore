# ── Godot 4+ generated / cache ────────────────────────────────
.godot/
/imported/
*.exe
*.pck
*.zip

# ── Platform build folders ────────────────────────────────────
/android/
/ios/
/web-builds/
/builds/

# ── Export presets (machine-local, may contain keys) ─────────
export_presets.cfg
export.cfg

# ── Editor user settings ─────────────────────────────────────
*.editor
editor_layout.cfg
ide_communication.log

# ── OS / IDE junk ────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── VS Code workspace local ───────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ── Logs / temp ───────────────────────────────────────────────
*.log
logs/
tmp/
